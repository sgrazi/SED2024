			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1729558543542</Id>
					<Name><![CDATA[arribos]]></Name>
					<X>60</X><Y>180</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double r = uniform(0, 1);
    if (r < 4.0/40.0) {
        return uniform(6, 32);
    } else if (r < 5.0/40.0) {
        return uniform(33, 58);
    } else if (r < 11.0/40.0) {
        return uniform(59, 83);
    } else if (r < 16.0/40.0) {
        return uniform(84, 108);
    } else if (r < 19.0/40.0) {
        return uniform(109, 133);
    } else if (r < 25.0/40.0) {
        return uniform(134, 158);
    } else if (r < 29.0/40.0) {
        return uniform(159, 184);
    } else if (r < 32.0/40.0) {
        return uniform(185, 210);
    } else {
        return uniform(211, 236);
    }]]></Body>
				</Function>
			</Functions>
